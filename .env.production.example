# A public domain whose DNS A record points to the VPS IP address.
DOMAIN=api.example.com

# Generate independent, long random values before deploying.
SECRET_KEY=replace-with-openssl-rand-base64-48
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_DB=maintenance

# Needed only for browser clients; Flutter does not require CORS.
CORS_ORIGINS=https://dashboard.example.com
MAX_PHOTO_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25
