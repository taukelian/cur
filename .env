# --- Приложение ---
PROJECT_NAME=Maintenance API
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=*
MAX_PHOTO_SIZE_MB=10
MAX_AUDIO_SIZE_MB=25

# --- База данных (используется приложением и Alembic) ---
DATABASE_URL=postgresql+psycopg2://maintenance:maintenance@localhost:5432/maintenance

# --- Docker Compose (PostgreSQL + pgAdmin) ---
POSTGRES_USER=maintenance
POSTGRES_PASSWORD=maintenance
POSTGRES_DB=maintenance
POSTGRES_PORT=5432
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
